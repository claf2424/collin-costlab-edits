+export async function updateFormulaDispensingCost(
+  _prevState: ComponentFormState,
+  formData: FormData,
+): Promise<ComponentFormState> {
+  const { supabase, organization } = await requireOrganization();
+  const idResult = z.string().uuid().safeParse(text(formData, "id"));
+  if (!idResult.success) return { error: "Could not find this formula." };
+  const id = idResult.data;
+
+  // Dollars in, cents stored. Blank means $0.
+  const dollars = z.number({ error: "Enter a dollar amount." }).finite().nonnegative("Amounts can't be negative.");
+  const read = (key: string) => {
+    const raw = text(formData, key);
+    return raw === "" ? 0 : Number(raw);
+  };
+  const parsed = z
+    .object({
+      filling: dollars,
+      pv: dollars,
+      shipping: dollars,
+      overhead: dollars,
+    })
+    .safeParse({
+      filling: read("filling_dollars"),
+      pv: read("pv_dollars"),
+      shipping: read("shipping_dollars"),
+      overhead: read("overhead_dollars"),
+    });
+  if (!parsed.success) return formError(parsed.error, "Please check the amounts and try again.");
+  const input = {
+    dispense_filling_cents: Math.round(parsed.data.filling * 10000) / 100,
+    dispense_pv_cents: Math.round(parsed.data.pv * 10000) / 100,
+    dispense_shipping_cents: Math.round(parsed.data.shipping * 10000) / 100,
+    dispense_overhead_cents: Math.round(parsed.data.overhead * 10000) / 100,
+  };
+
+  // Per-order dispensing cost never feeds batch costs, so no batch recompute.
+  const { error } = await supabase
+    .from("formulas")
+    .update(input)
+    .eq("id", id)
+    .eq("organization_id", organization.id);
+  if (error) return { error: "Could not save the dispensing cost. Please try again." };
+
+  await audit("formula.dispensing_cost.updated", "formula", id, input);
+  revalidatePath(`/formulas/${id}`);
+  return { ok: true, nonce: crypto.randomUUID() };
+}
