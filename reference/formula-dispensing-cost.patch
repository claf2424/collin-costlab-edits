+/**
+ * Dispensing cost per order: what it costs to dispense one order of a master
+ * formula, on top of (and never mixed into) the cost of making the batch.
+ * Kept free of server-only imports so it can be tested and reused on the
+ * quote side.
+ */
+
+export type DispensingCostInput = {
+  fillingCents: number;
+  pvCents: number;
+  shippingCents: number;
+  overheadCents: number;
+  /** Packaging and material per order: quantity x unit cost. */
+  packaging: { quantity: number; unitCostCents: number }[];
+};
+
+export type DispensingCost = {
+  laborCents: number;
+  packagingCents: number;
+  overheadCents: number;
+  totalCents: number;
+};
+
+const money = (value: unknown) => {
+  const n = Number(value ?? 0);
+  return Number.isFinite(n) && n > 0 ? n : 0;
+};
+
+export function calculateDispensingCost(input: DispensingCostInput): DispensingCost {
+  const laborCents = money(input.fillingCents) + money(input.pvCents) + money(input.shippingCents);
+  const packagingCents = input.packaging.reduce(
+    (sum, line) => sum + money(line.quantity) * money(line.unitCostCents),
+    0,
+  );
+  const overheadCents = money(input.overheadCents);
+  return {
+    laborCents,
+    packagingCents,
+    overheadCents,
+    totalCents: laborCents + packagingCents + overheadCents,
+  };
+}
