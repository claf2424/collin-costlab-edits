+import assert from "node:assert/strict";
+import test from "node:test";
+import { calculateDispensingCost } from "../src/lib/dispensing-cost";
+
+test("sums labor, packaging, and overhead per order", () => {
+  const result = calculateDispensingCost({
+    fillingCents: 150,
+    pvCents: 200,
+    shippingCents: 50,
+    overheadCents: 25,
+    packaging: [
+      { quantity: 1, unitCostCents: 85 },
+      { quantity: 4, unitCostCents: 12.5 },
+    ],
+  });
+  assert.deepEqual(result, {
+    laborCents: 400,
+    packagingCents: 135,
+    overheadCents: 25,
+    totalCents: 560,
+  });
+});
+
+test("an empty dispensing cost is $0", () => {
+  const result = calculateDispensingCost({
+    fillingCents: 0,
+    pvCents: 0,
+    shippingCents: 0,
+    overheadCents: 0,
+    packaging: [],
+  });
+  assert.equal(result.totalCents, 0);
+});
+
+test("ignores negative or non-numeric values", () => {
+  const result = calculateDispensingCost({
+    fillingCents: Number.NaN,
+    pvCents: -100,
+    shippingCents: 100,
+    overheadCents: 0,
+    packaging: [{ quantity: -2, unitCostCents: 50 }],
+  });
+  assert.equal(result.totalCents, 100);
+});
