+-- 0025_formula_dispensing_cost.sql
+--
+-- Dispensing cost per order on the master formula.
+--
+-- What it costs to dispense ONE order of a product, separate from what it
+-- costs to make the batch. It is never added to the batch cost breakdown or
+-- the per-unit all-in cost; it is carried to the quote side as its own figure.
+--
+--   Labor      flat $ per order: filling, pharmacist verification (PV), shipping
+--   Packaging  library components (Xpander pack, ice pack, ...) x quantity per
+--              order, priced at each component's preferred manufacturer
+--   Overhead   flat $ per order
+--
+-- Additive: every existing formula gets $0 in each field and no packaging
+-- lines, so nothing already shown changes value.
+
+alter table public.formulas
+  add column if not exists dispense_filling_cents numeric(14, 4) not null default 0
+    check (dispense_filling_cents >= 0),
+  add column if not exists dispense_pv_cents numeric(14, 4) not null default 0
+    check (dispense_pv_cents >= 0),
+  add column if not exists dispense_shipping_cents numeric(14, 4) not null default 0
+    check (dispense_shipping_cents >= 0),
+  add column if not exists dispense_overhead_cents numeric(14, 4) not null default 0
+    check (dispense_overhead_cents >= 0);
+
+comment on column public.formulas.dispense_filling_cents is 'Dispensing labor per order: filling.';
+comment on column public.formulas.dispense_pv_cents is 'Dispensing labor per order: pharmacist verification.';
+comment on column public.formulas.dispense_shipping_cents is 'Dispensing labor per order: shipping.';
+comment on column public.formulas.dispense_overhead_cents is 'Dispensing overhead per order.';
+
+create table if not exists public.formula_dispensing_items (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  formula_id uuid not null references public.formulas(id) on delete cascade,
+  component_id uuid not null references public.components(id) on delete restrict,
+  quantity numeric(14, 4) not null check (quantity > 0),
+  created_at timestamptz not null default now()
+);
+
+create index if not exists formula_dispensing_items_formula_idx
+  on public.formula_dispensing_items (formula_id);
+create index if not exists formula_dispensing_items_component_idx
+  on public.formula_dispensing_items (component_id);
+create index if not exists formula_dispensing_items_org_idx
+  on public.formula_dispensing_items (organization_id);
+
+comment on table public.formula_dispensing_items is
+  'Packaging and material used per dispensed order of a master formula (not per batch).';
+
+-- A packaging line belongs to the same pharmacy as its formula and component.
+create or replace function public.formula_dispensing_items_guard()
+returns trigger
+language plpgsql
+security definer
+set search_path = public
+as $$
+begin
+  if not exists (
+    select 1 from public.formulas f
+    where f.id = new.formula_id and f.organization_id = new.organization_id
+  ) then
+    raise exception 'Formula does not belong to this organization';
+  end if;
+  if not exists (
+    select 1 from public.components c
+    where c.id = new.component_id and c.organization_id = new.organization_id
+  ) then
+    raise exception 'Component does not belong to this organization';
+  end if;
+  return new;
+end;
+$$;
+
+drop trigger if exists formula_dispensing_items_guard on public.formula_dispensing_items;
+create trigger formula_dispensing_items_guard
+  before insert or update on public.formula_dispensing_items
+  for each row execute function public.formula_dispensing_items_guard();
+
+-- Same access as the rest of the master formula (see 0020_rls_performance).
+alter table public.formula_dispensing_items enable row level security;
+
+drop policy if exists "tenant_select_formula_dispensing_items" on public.formula_dispensing_items;
+create policy "tenant_select_formula_dispensing_items" on public.formula_dispensing_items for select
+using (organization_id in (select public.user_org_ids()));
+
+drop policy if exists "tenant_insert_formula_dispensing_items" on public.formula_dispensing_items;
+create policy "tenant_insert_formula_dispensing_items" on public.formula_dispensing_items for insert
+with check (organization_id in (select public.user_org_ids_with_roles(array['owner','admin','pharmacist']::public.app_role[])));
+
+drop policy if exists "tenant_update_formula_dispensing_items" on public.formula_dispensing_items;
+create policy "tenant_update_formula_dispensing_items" on public.formula_dispensing_items for update
+using (organization_id in (select public.user_org_ids_with_roles(array['owner','admin','pharmacist']::public.app_role[])))
+with check (organization_id in (select public.user_org_ids_with_roles(array['owner','admin','pharmacist']::public.app_role[])));
+
+drop policy if exists "tenant_delete_formula_dispensing_items" on public.formula_dispensing_items;
+create policy "tenant_delete_formula_dispensing_items" on public.formula_dispensing_items for delete
+using (organization_id in (select public.user_org_ids_with_roles(array['owner','admin','pharmacist']::public.app_role[])));
